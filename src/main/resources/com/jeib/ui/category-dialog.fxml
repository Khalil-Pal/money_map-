<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- New / Edit category: name and color; delete asks once more because it can't be undone. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jeib.ui.CategoryDialogController" styleClass="dialog" maxWidth="480" maxHeight="-Infinity">

    <Label fx:id="title" styleClass="dialog-title"/>

    <VBox styleClass="field">
        <Label text="Name" styleClass="field-label"/>
        <TextField fx:id="nameField" promptText="e.g. Coffee"/>
        <Label fx:id="nameError" styleClass="field-error" wrapText="true"/>
    </VBox>

    <VBox styleClass="field">
        <Label text="Color" styleClass="field-label"/>
        <FlowPane fx:id="colors" hgap="6" vgap="6"/>
        <Label fx:id="colorHint" styleClass="hint" wrapText="true"/>
        <Label fx:id="colorError" styleClass="field-error" wrapText="true"/>
    </VBox>

    <Label fx:id="formError" styleClass="field-error" wrapText="true"/>

    <HBox fx:id="confirmBox" styleClass="confirm-box">
        <Label fx:id="confirmText" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="keepButton" text="Keep it" styleClass="button-secondary" minWidth="-Infinity"/>
    </HBox>

    <HBox styleClass="dialog-buttons">
        <Button fx:id="deleteButton" text="Delete" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="Cancel" cancelButton="true" styleClass="button-secondary"/>
        <Button fx:id="categorySave" text="Save" defaultButton="true" styleClass="button-primary"/>
    </HBox>
</VBox>
