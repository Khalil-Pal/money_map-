<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Set, change, or remove one monthly limit. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jeib.ui.LimitDialogController" styleClass="dialog" maxWidth="460" maxHeight="-Infinity">

    <Label fx:id="title" styleClass="dialog-title"/>
    <Label fx:id="hint" styleClass="muted" wrapText="true"/>

    <VBox styleClass="field">
        <Label text="%Limit per month" styleClass="field-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="limitField" promptText="%e.g. 10000" styleClass="amount-input" HBox.hgrow="ALWAYS"/>
            <Label fx:id="unit" styleClass="muted"/>
        </HBox>
        <Label fx:id="error" styleClass="field-error" wrapText="true"/>
    </VBox>

    <HBox styleClass="dialog-buttons">
        <Button fx:id="removeButton" text="%Remove limit" styleClass="button-danger"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="%Cancel" cancelButton="true" styleClass="button-secondary"/>
        <Button fx:id="limitSave" text="%Save" defaultButton="true" styleClass="button-primary"/>
    </HBox>
</VBox>
