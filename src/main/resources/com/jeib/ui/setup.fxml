<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- First-launch setup: choose the main currency. Can't be skipped: amounts need a currency to total in. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jeib.ui.SetupController" styleClass="dialog" maxWidth="560" maxHeight="-Infinity">

    <HBox styleClass="setup-top">
        <ImageView fitWidth="44" fitHeight="44" preserveRatio="true" smooth="true">
            <Image url="@logo.png"/>
        </ImageView>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="languageBox" styleClass="segmented" maxHeight="-Infinity"/>
    </HBox>
    <Label text="%Welcome to Jeib" styleClass="dialog-title"/>
    <Label styleClass="muted" wrapText="true"
           text="%Choose your main currency. Your totals, limits, and daily budget are shown in it. You can still enter amounts in the other two currencies."/>

    <HBox fx:id="choices" spacing="12"/>
    <Label fx:id="error" styleClass="field-error" wrapText="true"/>

    <HBox styleClass="dialog-buttons">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="continueButton" text="%Continue" defaultButton="true" styleClass="button-primary"/>
    </HBox>
</VBox>
