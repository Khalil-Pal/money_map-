<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Dashboard: three number cards, where the money went (donut + legend), and the most urgent limits. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jeib.ui.DashboardController" styleClass="dashboard-page">

    <HBox fx:id="planControls" spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="dashboardPlan" promptText="%Budget plan" accessibleText="%Budget plan"/>
        <Button fx:id="showMonthlyOverview" text="%Monthly overview" styleClass="button-link"/>
    </HBox>
    <VBox fx:id="planOverview" styleClass="card,settings-card"/>
    <VBox fx:id="monthlyOverview" styleClass="dashboard-page">
        <Label fx:id="warning" styleClass="warning-note" wrapText="true" maxWidth="Infinity"/>
        <Label fx:id="message" styleClass="tx-message" wrapText="true" maxWidth="Infinity"/>

        <HBox fx:id="cards" styleClass="kpi-row"/>

        <HBox styleClass="dashboard-row">
            <VBox fx:id="chartCard" styleClass="card,dashboard-card" HBox.hgrow="ALWAYS" prefWidth="0" maxWidth="Infinity"/>
            <VBox fx:id="limitsCard" styleClass="card,dashboard-card" HBox.hgrow="ALWAYS" prefWidth="0" maxWidth="Infinity"/>
        </HBox>
    </VBox>
</VBox>
